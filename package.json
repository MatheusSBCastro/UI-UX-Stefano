{
  "name": "ui-ux-stefano",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kit reutilizável de interfaces com React, UI UX Pro Max, componentes do 21st.dev e Motion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "design": "node scripts/design-system.mjs",
    "test:ui": "playwright test",
    "setup:python": "node scripts/setup-python.mjs",
    "dev:spider": "vite --config testes/homem-aranha/vite.config.ts --host 127.0.0.1 --port 5175 --strictPort",
    "build:spider": "tsc --noEmit --project testes/homem-aranha/tsconfig.json && vite build --config testes/homem-aranha/vite.config.ts",
    "preview:spider": "vite preview --config testes/homem-aranha/vite.config.ts --host 127.0.0.1 --port 4175 --strictPort",
    "test:spider": "playwright test --config testes/homem-aranha/playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
